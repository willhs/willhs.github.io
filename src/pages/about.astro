---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

const socials = [
  {
    name: 'Email',
    url: 'mailto:will@willhs.me',
    handle: 'will@willhs.me',
    icon: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 2h13c.83 0 1.5.67 1.5 1.5v9c0 .83-.67 1.5-1.5 1.5h-13C.67 14 0 13.33 0 12.5v-9C0 2.67.67 2 1.5 2zm0 1a.5.5 0 0 0-.5.5v.38l7 4.12 7-4.12V3.5a.5.5 0 0 0-.5-.5h-13zm13.5 2.04-6.74 3.97a.5.5 0 0 1-.52 0L1 5.04V12.5a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5V5.04z"/></svg>`,
  },
  {
    name: 'GitHub',
    url: 'https://github.com/willhs',
    handle: 'willhs',
    icon: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>`,
  },
  {
    name: 'X',
    url: 'https://x.com/WillSolo1',
    handle: '@WillSolo1',
    icon: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M9.52 6.78 15.48 0h-1.41L8.89 5.88 4.76 0H0l6.25 8.9L0 16h1.41l5.46-6.21L11.24 16H16L9.52 6.78zm-1.93 2.2-.63-.89L1.92 1.04h2.17l4.07 5.7.63.89 5.29 7.41h-2.17l-4.32-6.06z"/></svg>`,
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/will-hardwick-smith-0100267a/',
    handle: 'will-hardwick-smith',
    icon: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.63 13.63h-2.37V9.92c0-.89-.02-2.03-1.24-2.03-1.24 0-1.43.97-1.43 1.96v3.78H6.22V6h2.28v1.04h.03c.32-.6 1.09-1.24 2.25-1.24 2.4 0 2.85 1.58 2.85 3.64v4.19zM3.54 4.96a1.38 1.38 0 1 1 0-2.75 1.38 1.38 0 0 1 0 2.75zM4.73 13.63H2.36V6h2.37v7.63zM14.82 0H1.18C.53 0 0 .52 0 1.15v13.7C0 15.48.53 16 1.18 16h13.63c.65 0 1.19-.52 1.19-1.15V1.15C16 .52 15.46 0 14.82 0z"/></svg>`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="about" description="About will hs" />
  </head>
  <body>
    <Header />
    <main class="container">
      <h1>about</h1>
      <p>Hi, I'm Will Hardwick-Smith <span class="sep">·</span> Software Engineer in Wellington, New Zealand</p>
      <p>Exploring what's possible with AI and software</p>
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a href={s.url} rel="me">
              <span class="icon" set:html={s.icon} />
              <span class="handle">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>

<style>
  .sep {
    color: var(--color-text-muted);
    margin: 0 0.15rem;
  }
  .socials {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .socials a:hover {
    color: var(--color-link-hover);
  }
  .icon {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
</style>
